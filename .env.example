APP_NAME=Voice Portal
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/voiceportal.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
# Optional. Comma-separated. Empty = any signed-in Microsoft user.
ALLOWED_EMAILS=

# Shared iOS shortcut template (one for everyone — not per-user signed files)
SHORTCUT_ICLOUD_URL=
SHORTCUT_FILE_URL=

# LLMrouterVEX only — no OpenAI / xAI / Groq.
# Use the router LAN or Tailscale IP. /v1 is added if omitted.
# https://github.com/keberling/LLMrouterVEX
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Aliases also accepted: LLM_ROUTER_URL, LLM_ROUTER_API_TOKEN, LLM_ROUTER_MODEL, LM_API_KEY
# Router token if LLMROUTER_API_TOKEN is set; otherwise any placeholder is fine.
LLM_API_KEY=local
LLM_MODEL=auto
# STT uses the same router (/v1/audio/transcriptions → local Whisper).
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
