APP_NAME=Voice Portal
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/voiceportal.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
# Optional. Comma-separated. Empty = any signed-in Microsoft user.
ALLOWED_EMAILS=

# Shared iOS shortcut template (one for everyone — not per-user signed files)
SHORTCUT_ICLOUD_URL=
SHORTCUT_FILE_URL=

# OpenAI-compatible router (do not hardcode a vendor)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional STT overrides (default to LLM_* )
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
